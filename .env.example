# --- הרצה מקומית (npm run dev) ---
# לא צריך אף אחד מהמשתנים למטה בשביל הרצה מקומית רגילה.
# הם רלוונטיים רק לפריסה מקוונת לקריאה-בלבד (Netlify) - ראו README.

# מצב קריאה-בלבד: חוסם כל עריכה/מחיקה/העלאה, גם ב-API וגם ב-UI
READ_ONLY=true

# איפה שמורים הנתונים בפרודקשן (אין דיסק מקומי קבוע ב-Netlify)
DATA_BACKEND=netlify-blobs

# Google OAuth (מ-Google Cloud Console → APIs & Services → Credentials)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# מפתח סודי אקראי ל-NextAuth (ליצור עם: openssl rand -base64 32)
AUTH_SECRET=

# כתובת ה-URL הציבורית של האתר אחרי הפריסה
AUTH_URL=https://your-site.netlify.app

# רשימת הדוא"ל היחידה שמורשית להתחבר, מופרדת בפסיקים
ALLOWED_EMAILS=tomerg@gmail.com,roni@example.com

# --- רק בשביל scripts/sync-to-netlify.mjs (מריצים מקומית) ---
NETLIFY_BLOBS_SITE_ID=
NETLIFY_BLOBS_TOKEN=
